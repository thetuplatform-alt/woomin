model EmailConsentLog {
  id           String             @id @default(cuid())
  userId       String?
  email        String
  consentType  EmailConsentType
  action       EmailConsentAction
  source       String
  ip           String?
  market       String?
  termsVersion String?
  campaignId   String?
  createdAt    DateTime           @default(now())

