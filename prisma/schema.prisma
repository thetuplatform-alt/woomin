  type       NewsletterAlertType @default(INFO)
  title      String
  message    String              @db.Text
  campaignId String?
  readAt     DateTime?
  createdAt  DateTime            @default(now())

  campaign NewsletterCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([readAt, createdAt])
  @@index([campaignId])
}

model NewsletterAutomation {
  id        String   @id @default(cuid())
  courseId  String   @unique
  name      String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course                           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  steps       NewsletterAutomationStep[]
  enrollments NewsletterAutomationEnrollment[]

  @@index([enabled])
}

model NewsletterAutomationStep {
  id              String   @id @default(cuid())
  automationId    String
  stepOrder       Int
  delayDays       Int      @default(0)
  delayHours      Int      @default(0)
  subjectTemplate String
  contentJson     Json
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  automation NewsletterAutomation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  deliveries NewsletterAutomationDelivery[]

  @@unique([automationId, stepOrder])
  @@index([automationId, enabled, stepOrder])
}

model NewsletterAutomationEnrollment {
  id           String   @id @default(cuid())
  userId       String
  automationId String
  orderId      String
  enrolledAt   DateTime

  user       User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  automation NewsletterAutomation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  order      Order                          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveries NewsletterAutomationDelivery[]

  @@unique([userId, automationId])
  @@index([automationId, enrolledAt])
  @@index([orderId])
}

model NewsletterAutomationDelivery {
  id                String                             @id @default(cuid())
  enrollmentId      String
  stepId            String?
  status            NewsletterAutomationDeliveryStatus @default(PENDING)
  scheduledAt       DateTime
  sentAt            DateTime?
  providerMessageId String?
  errorMessage      String?                            @db.Text
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt

  enrollment NewsletterAutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       NewsletterAutomationStep?      @relation(fields: [stepId], references: [id], onDelete: SetNull)
  opens      NewsletterAutomationOpen[]
  clicks     NewsletterAutomationClick[]

  @@unique([enrollmentId, stepId])
  @@index([status, scheduledAt])
  @@index([stepId])
}

model NewsletterAutomationOpen {
  id         String   @id @default(cuid())
  deliveryId String
  userId     String
  openedAt   DateTime @default(now())

  delivery NewsletterAutomationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  user     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deliveryId, openedAt])
  @@index([userId, openedAt])
}

model NewsletterAutomationClick {
  id         String   @id @default(cuid())
  deliveryId String
  userId     String
  url        String   @db.Text
  clickedAt  DateTime @default(now())

  delivery NewsletterAutomationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  user     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deliveryId, clickedAt])
  @@index([userId, clickedAt])
}

enum PurchaseSource {
  PAID // 付費購買
  BUNDLE // 透過組合包購買授權
  FREE_ENROLL // 免費課程自行加入
  ADMIN_GRANT // 管理員手動授權
  ADMIN_IMPORT // 批次匯入
  SUBSCRIPTION // 課程訂閱制（每期扣款延展授權）
}

/**
 * 到期提醒發送記錄
 * 用於避免同一張 Purchase 的同一個天數提醒被重複寄送
 */
model CourseExpirationReminder {
  id         String   @id @default(cuid())
  purchaseId String
  daysBefore Int // 發送時距到期還剩幾天（例：30、7、1、0 表示已過期）
  sentAt     DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, daysBefore])
  @@index([sentAt])
}

model CourseWelcomeEmail {
  id               String   @id @default(cuid())
  courseId         String
  planSlug         String   @default("basic")
  enabled          Boolean  @default(false)
  subjectTemplate  String
  markdownTemplate String   @db.Text
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, planSlug])
  @@index([enabled])
  @@index([planSlug])
}

model EmailDeliveryLog {
  id                String              @id @default(cuid())
  type              EmailDeliveryType
  status            EmailDeliveryStatus @default(PENDING)
  orderId           String?
  userId            String?
  courseId          String?
  planSlug          String?
  toEmail           String
  subject           String
  providerMessageId String?
  errorMessage      String?             @db.Text
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // 冪等鍵含 courseId：組合包訂單同一 orderId 下每門課各自獨立寄送一次（修正只寄第一門課的問題）
  @@unique([type, orderId, courseId])
  @@index([courseId, createdAt])
  @@index([planSlug, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model GhostGrantLog {
  id       String           @id @default(cuid())
  orderId  String           @unique
  userId   String
  courseId String
  planSlug String
  email    String
  status   GhostGrantStatus @default(PENDING)

  ghostMemberId String?
  ghostTierId   String?
  expiresAt     DateTime?
  errorMessage  String?   @db.Text
  attempts      Int       @default(0)
  grantedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([courseId, planSlug])
}

model OrbivoGrantLog {
  id       String            @id @default(cuid())
  orderId  String            @unique
  userId   String
  courseId String
  planSlug String
  email    String
  status   OrbivoGrantStatus @default(PENDING)

  errorMessage String?   @db.Text
  attempts     Int       @default(0)
  grantedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model GuestActivationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ==================== 媒體資源 ====================

enum MediaType {
  IMAGE
  VIDEO
  ATTACHMENT
}

enum MediaSourceType {
  MANUAL
  LESSON_CONTENT
  ASSIGNMENT
  COMMENT
  PRIVATE_MESSAGE
  CLOUDFLARE_SYNC
}

model Media {
  id           String    @id @default(cuid())
  type         MediaType
  filename     String
  originalName String
  mimeType     String
  size         Int // bytes
  url          String

  // Cloudflare Stream 專用
  cfStreamId String? @unique // Cloudflare Stream UID
  cfStatus   String? // ready, pending, error
  bunnyVideoId String? @unique // Bunny Stream video GUID
  bunnyStatus String? // processing, ready, failed
  duration   Int? // 影片長度（秒）
  thumbnail  String? // 縮圖 URL

  uploadedBy String? // 上傳者 User ID
  createdAt  DateTime @default(now())

  allowDownload           Boolean @default(true)
  dynamicWatermarkEnabled Boolean @default(false)
  watermarkConfig         Json?

  sourceType  MediaSourceType @default(MANUAL)
  sourceId    String?
  sourceLabel String?
  sourceUrl   String?

  @@index([type])
  @@index([dynamicWatermarkEnabled])
  @@index([sourceType])
  @@index([sourceId])
}

