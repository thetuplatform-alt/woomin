// ==================== 單元測驗系統 ====================

enum QuizQuestionType {
  SINGLE_CHOICE // 單選題
  MULTIPLE_CHOICE // 多選題
  TRUE_FALSE // 是非題
  FILL_IN_BLANK // 填空題
}

enum ShowAnswersStrategy {
  IMMEDIATELY // 送出後立即顯示
  AFTER_PASS // 通過後才顯示
  NEVER // 永不顯示
}

model Quiz {
  id       String @id @default(cuid())
  lessonId String @unique

  passingScore     Int                 @default(60) // 及格分數 (0-100)
  timeLimitMinutes Int? // 作答時間限制（分鐘），null = 不限時
  shuffleQuestions Boolean             @default(false) // 題目順序隨機
  shuffleOptions   Boolean             @default(false) // 選項順序隨機
  showAnswers      ShowAnswersStrategy @default(IMMEDIATELY) // 答案顯示策略
  blockNextLesson  Boolean             @default(false) // 未通過阻擋後續單元

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id     String @id @default(cuid())
  quizId String

  type          QuizQuestionType
  content       String           @db.Text // 題幹
  options       Json? // 選項陣列 [{ id: string, text: string }]（選擇題/是非題用）
  correctAnswer Json // 正確答案（單選: string, 多選: string[], 是非: boolean, 填空: string[]）
  explanation   String?          @db.Text // 答案解析（選填）
  points        Int              @default(1) // 分數權重
  order         Int              @default(0) // 排序

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

model QuizAttempt {
  id     String  @id @default(cuid())
  quizId String?
  userId String

  answers          Json // 學員的答案 { [questionId]: answer }
  score            Int // 得分 (0-100)
  passed           Boolean // 是否通過
  timeTakenSeconds Int? // 實際作答秒數
  startedAt        DateTime @default(now())
  submittedAt      DateTime @default(now())

  quiz Quiz? @relation(fields: [quizId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
  @@index([userId, quizId])
}

// ==================== 單元作業系統 ====================

enum AssignmentSubmissionType {
  TEXT // 純文字
  IMAGE // 圖片
  FILE // 檔案
  MIXED // 混合（文字 + 圖片 + 檔案）
}

enum AssignmentEditorMode {
  PLAIN // 純文字
  MARKDOWN // Markdown 編輯器
}

enum AssignmentGradingType {
  PASS_FAIL // 通過 / 退回 / 不通過
  PERCENTAGE // 百分制
  LETTER_GRADE // 等第制
}

enum AssignmentSubmissionStatus {
  DRAFT // 草稿
  SUBMITTED // 已送出
  UNDER_REVIEW // 批改中
  APPROVED // 通過
  NEEDS_REVISION // 退回修改
  REJECTED // 不通過
}

enum AssignmentReviewStatus {
  APPROVED // 通過
  NEEDS_REVISION // 退回修改
  REJECTED // 不通過
}

enum AssignmentAttachmentType {
  IMAGE // 圖片
  FILE // 一般檔案
}

model Assignment {
  id       String @id @default(cuid())
  lessonId String @unique

  title       String
  description String @db.Text // 作業說明（Markdown）

  // 提交類型與限制
  submissionType    AssignmentSubmissionType
  editorMode        AssignmentEditorMode     @default(MARKDOWN)
  minWords          Int? // 最少字數
  maxWords          Int? // 最多字數
  maxImages         Int?                     @default(10) // 最大圖片數量
  maxImageSize      Int?                     @default(10485760) // 單張圖片大小上限 (bytes, 預設 10MB)
  maxFiles          Int?                     @default(5) // 最大檔案數量
  maxFileSize       Int?                     @default(10485760) // 單檔大小上限 (bytes, 預設 10MB)
  allowedExtensions Json? // 允許的副檔名 string[]（null = 使用預設白名單）

  // 評分設定
  gradingType  AssignmentGradingType @default(PASS_FAIL)
  passingScore Int?                  @default(60) // 百分制的及格分數

  // 時間與重交
  deadline            DateTime? // 截止日期
  allowLateSubmission Boolean   @default(false) // 允許遲交
  allowResubmission   Boolean   @default(true) // 允許重新提交

  // 自動清理
  autoCleanupDays Int? // 通過後 N 天自動刪除附件（null = 不清理）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
  drafts      AssignmentDraft[]
}

model AssignmentSubmission {
  id           String @id @default(cuid())
  assignmentId String
  userId       String

  // 文字內容
  content       String?               @db.Text // 文字作業內容
  contentFormat AssignmentEditorMode? // 內容格式
  wordCount     Int? // 字數

  // 狀態
  status         AssignmentSubmissionStatus @default(DRAFT)
  revisionNumber Int                        @default(1) // 第幾次提交
  isLate         Boolean                    @default(false) // 是否遲交
  submittedAt    DateTime? // 送出時間

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment  Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments AssignmentAttachment[]
  reviews     AssignmentReview[]

  @@index([assignmentId, userId])
  @@index([assignmentId, status])
  @@index([userId])
}

model AssignmentAttachment {
  id           String @id @default(cuid())
  submissionId String

  filename      String
  mimeType      String
  size          Int // bytes
  url           String
  storageKey    String
  storageDriver String // 'local' | 's3'
  type          AssignmentAttachmentType

  createdAt DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model AssignmentReview {
  id           String @id @default(cuid())
  submissionId String
  reviewerId   String

  status      AssignmentReviewStatus
  feedback    String?                @db.Text // 整體評語
  score       Int? // 百分制分數 (0-100)
  letterGrade String? // 等第 (A/B/C/D/F)
  reviewedAt  DateTime               @default(now())

  createdAt DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User                 @relation(fields: [reviewerId], references: [id])

  @@index([submissionId])
  @@index([reviewerId])
}

model AssignmentDraft {
  id           String @id @default(cuid())
  assignmentId String
  userId       String

  content       String?               @db.Text // 草稿文字內容
  contentFormat AssignmentEditorMode? // 內容格式

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([userId])
}
