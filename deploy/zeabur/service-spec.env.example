# Non-secret production service contract. Replace placeholders in Zeabur UI.
IMAGE_REF=ghcr.io/customer/woomin@sha256:<verified-digest>
PORT=8080
HOSTNAME=0.0.0.0
DATABASE_URL=${POSTGRES_CONNECTION_STRING}
APP_URL=https://<customer-domain>
NEXT_PUBLIC_APP_URL=https://<customer-domain>
GIT_COMMIT_SHA=<full-commit-sha>
LOCAL_STORAGE_ROOT=/data/uploads
VOLUME_MOUNT=/data
DEPENDENCY_ORDER=postgresql-before-app
