# ===========================================
# Minimal setup
# Zeabur-first deployment only requires this.
# ===========================================

DATABASE_URL="postgresql://user:password@localhost:5432/course_platform"

# ===========================================
# Optional platform developer settings
# Most features can be configured later in /admin/setup or /admin/settings.
# ===========================================

# Platform update service
# PLATFORM_UPDATE_API_URL=""
# PLATFORM_API_KEY=""

# ===========================================
# Optional advanced integrations
# Leave empty unless you are enabling these features on purpose.
# ===========================================

# OpenAI + Composio agent example
# OPENAI_API_KEY=""
# COMPOSIO_API_KEY=""
# COMPOSIO_USER_ID="user_bgb2dg"
# OPENAI_AGENT_MODEL="gpt-4.1"

# Cloudflare Stream
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_STREAM_CUSTOMER_CODE=""
# CLOUDFLARE_STREAM_SIGNING_SECRET=""

# S3-compatible object storage
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME=""
# S3_PUBLIC_URL=""
# S3_REGION="auto"
# S3_FORCE_PATH_STYLE="false"
# LOCAL_STORAGE_ROOT="/data/uploads"

# Email provider fallbacks
# Existing env values will be backfilled into SiteSetting during build.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# TOSEND_API_KEY=""
# TOSEND_API_BASE_URL="https://api.tosend.com/v2"
# EMAIL_FROM="noreply@example.com"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"

# Newsletter delivery
# Required before sending newsletters. Generate both with: openssl rand -base64 32
# NEWSLETTER_UNSUBSCRIBE_SECRET=""
# CRON_SECRET=""
# Optional: required only when enabling Resend bounce/complaint webhooks.
# RESEND_WEBHOOK_SECRET=""

# OAuth fallback credentials
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_APPLE_ID=""
# AUTH_APPLE_TEAM_ID=""
# AUTH_APPLE_KEY_ID=""
# AUTH_APPLE_PRIVATE_KEY=""
